# Select the mode for direct Node.js deployments. Docker Compose overrides this
# value based on the selected compose file.
SIGNER_MODE=local

# Local signer mode
PRIVATE_KEYS=[{"walletId":1,"key":"<PRIVATE_KEY>"}]

# Node RPC endpoints keyed by chain ID
NODE_URI_MAP=[{"11155111":{"key":"https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_API_KEY>","multiplier":3}},{"11155420":{"key":"https://opt-sepolia.g.alchemy.com/v2/<ALCHEMY_API_KEY>","multiplier":2}},{"10":{"key":"https://opt-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>","multiplier":1.5}},{"1":{"key":"https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>","multiplier":2}}]

# Authentik (OIDC)
AUTHENTIK_JWKS_URI=<authentik_jwks_uri>
AUTHENTIK_ISSUER=<authentik_issuer_url>
AUTHENTIK_AUDIENCE=<authentik_oidc_client_id>
UPSTREAM_IDP=<participant_authentik_idp_slug_or_id>

# Optional: array of allowed browser origins.
# When unset, origin checks are disabled. When set, requests without a
# matching Origin header are rejected before JWT validation.
ALLOWED_ORIGINS='["https://market-git-feat-stage-ocean-enterprise.vercel.app","https://wallet-dev-stage.oceanenterprise.io","https://signerserver.demo.oceanenterprise.io:8443"]'
# Server
PORT=3001
NODE_ENV=development

# Docker Compose host port
SIGNER_PORT=8443

# Optional: enable HTTPS directly in signer-server when both cert and key are set.
#HTTP_CERT_PATH=/etc/ssl/certs/cert.pem
#HTTP_KEY_PATH=/etc/ssl/certs/key.pem

