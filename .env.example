# Signer mode: local or openbao
SIGNER_MODE=local

# Local signer mode
PRIVATE_KEYS=[{"walletId":1,"key":"<PRIVATE_KEY>"}]

# OpenBao signer mode
VAULT_URL=http://localhost:8200
VAULT_TOKEN=<VAULT_TOKEN>
VAULT_ETHEREUM_MOUNT=ethereum
VAULT_KV_STORE_PATH=secret
VAULT_TIMEOUT_MS=10000

# Node RPC endpoints keyed by chain ID
NODE_URI_MAP={"11155111":"https://<your-rpc-provider-url-and-key>"}

# Authentik (OIDC)
AUTHENTIK_JWKS_URI=<authentik_jwks_uri>
AUTHENTIK_ISSUER=<authentik_issuer_url>
AUTHENTIK_AUDIENCE=<authentik_oidc_client_id>

# Server
PORT=3001
NODE_ENV=development

# Optional: enable HTTPS directly in signer-server when both cert and key are set.
#HTTP_CERT_PATH=/etc/ssl/certs/cert.pem
#HTTP_KEY_PATH=/etc/ssl/certs/key.pem

# Optional: fallback API key for backward compatibility (optional)
API_KEY_FALLBACK=changeme
